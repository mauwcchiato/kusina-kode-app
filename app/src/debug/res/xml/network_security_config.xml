<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of the release network security config.

  This file replaces src/main/res/xml/network_security_config.xml in debug
  builds (variant source sets take precedence). QA repoints debug builds at an
  arbitrary local XAMPP / LAN laptop from the Settings > SERVER section, so
  cleartext has to stay open to any host here. Release builds never see this
  file and keep the strict all-list in src/main.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
