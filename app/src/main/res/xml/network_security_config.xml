<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain HTTP) policy for release builds.

  The production API is now served over HTTPS (Let's Encrypt certificate on
  kusinakode.southeastasia.cloudapp.azure.com), and ServerConfig uses https for
  it - so a release build never needs plain HTTP at all. Cleartext is therefore
  denied outright here: if anything on a shipped build ever tries to send over
  http://, it fails instead of leaking in the clear.

  Debug builds use a separate, permissive copy of this file in src/debug, so QA
  can still point at a local XAMPP over http from Settings.

  History: this file previously whitelisted the bare IP 4.193.189.219 for
  cleartext, because the API was http-only. That entry is gone now that TLS is
  in place.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
