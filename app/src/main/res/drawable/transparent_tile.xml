<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing, on purpose.

    LevelImage always draws its fallback when a fetch fails, which is right for
    a dish card and wrong for a tool: the tool already has something sensible
    drawn underneath it, either the artwork packaged in the APK or a
    keyword-matched icon. Handing it a transparent drawable lets that show
    through instead of covering it with an unrelated picture.

    A vector, not a <shape>: painterResource() accepts VectorDrawables and
    rasterized assets only, and throws on anything else.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h1v1h-1z" />
</vector>
