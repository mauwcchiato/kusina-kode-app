#!/bin/sh
# Strip Claude Code attribution from commit messages.
msg="$1"
tmp="$(mktemp)"
sed -E '
  /^[[:space:]]*Co-Authored-By:[[:space:]]*Claude/Id
  /Generated with .*Claude Code/Id
' "$msg" | awk '
  { line[NR] = $0 }
  END {
    last = 0
    for (i = 1; i <= NR; i++) if (line[i] ~ /[^[:space:]]/) last = i
    for (i = 1; i <= last; i++) print line[i]
  }
' > "$tmp"
mv "$tmp" "$msg"
